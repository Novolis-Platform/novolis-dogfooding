<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>TorrentLab</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Dogfood Avalonia torrent session controls over Novolis.Transports.Torrent.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Novolis.Avalonia.Torrent" />
    <PackageReference Include="Novolis.Transports.Torrent" />
  </ItemGroup>
  <ItemGroup>
    <None Include="samples\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="samples" />
  </ItemGroup>
</Project>
