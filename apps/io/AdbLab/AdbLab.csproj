<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AdbLab</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <Description>Dogfood Novolis.IO.Mobile.Android — list devices, read props, inspect installed packages (Books Mobile).</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Novolis.IO.Mobile.Android" />
    <!-- ProjectRef mode is non-transitive for NuGet graphs. -->
    <PackageReference Include="AdvancedSharpAdbClient" />
  </ItemGroup>
</Project>
